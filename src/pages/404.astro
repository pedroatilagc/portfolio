---
import Base from '../layouts/Base.astro';
import { ui } from '../i18n';

// A Vercel serve um único 404.html para o site todo (inclusive /en/...), então a página é
// em português com uma linha em inglês apontando para a versão em inglês.
const t = ui.pt.notFound;
const en = ui.en.notFound;
---

<Base title={t.title} description={t.description}>
  <section class="container nf">
    <div class="term" aria-hidden="true">
      <span class="p">&gt; </span>page not found<span class="u">_</span>
    </div>
    <span class="eyebrow">{t.eyebrow}</span>
    <h1>{t.title}</h1>
    <p>{t.text}</p>
    <p class="en" lang="en">{en.title}. <a href="/en/">{en.home} →</a></p>
    <div class="ctas">
      <a class="btn btn-primary" href="/">{t.home} <span class="arrow arrow-x" aria-hidden="true">→</span></a>
      <a class="btn btn-secondary" href="/#projetos">{t.projects}</a>
    </div>
  </section>
</Base>

<style>
  .nf {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
    padding-block: clamp(5rem, 16vw, 10rem);
  }
  .term {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--text-strong);
    background: var(--bg-deep);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 0.8rem 1.1rem;
    margin-bottom: 1rem;
  }
  .p,
  .u {
    color: var(--accent);
  }
  :global(.motion-ok) .u {
    animation: blink 1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .en {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }
  .en a {
    color: var(--text-strong);
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
</style>
