---
/**
 * Seção "Custos e uso (OpenRouter)" do senderix-eval.
 * Reproduz os painéis do dashboard da OpenRouter como componentes e SVG gerados
 * no build, a partir de src/data/senderix-eval-openrouter.json.
 */
import dados from '../data/senderix-eval-openrouter.json';
import ChartPanel from './charts/ChartPanel.astro';
import KpiRow from './charts/KpiRow.astro';
import StackedBarChart from './charts/StackedBarChart.astro';
import AreaChart from './charts/AreaChart.astro';
import ModelBreakdown from './charts/ModelBreakdown.astro';
import { getLang, dayLabel } from '../i18n';

const { modelos, painelA: A0, painelB: B0 } = dados;
const lang = getLang(Astro.currentLocale);
const en = lang === 'en';

// No inglês, os dias "27/10" viram "Oct 27" (o JSON guarda o formato brasileiro).
const dias = <T extends { dia: string }>(arr: T[]): T[] => arr.map((d) => ({ ...d, dia: dayLabel(d.dia, lang) }));
const A = {
  ...A0,
  periodo: en ? 'Oct 1 – Oct 31, 2026, GMT-3' : A0.periodo,
  custoDiario: dias(A0.custoDiario),
  gastoDiario: dias(A0.gastoDiario),
};
const B = {
  ...B0,
  periodo: en ? 'Sep 30 – Oct 29, 2026, GMT-3' : B0.periodo,
  requisicoes: dias(B0.requisicoes),
  tokens: dias(B0.tokens),
  cache: dias(B0.cache),
};

// Checagem no build: a soma das barras diárias de cada modelo precisa bater com a
// coluna "soma" oficial da OpenRouter (tolerância de $0.001). Se o JSON for
// editado e deixar de bater, o build falha em vez de publicar números incoerentes.
for (const linha of A.tabela) {
  const somaBarras = A.custoDiario.reduce(
    (s, d) => s + ((d.valores as Record<string, number>)[linha.modelo] ?? 0),
    0,
  );
  if (Math.abs(somaBarras - linha.soma) > 0.001) {
    throw new Error(
      `[CustosOpenRouter] ${linha.modelo}: barras somam ${somaBarras.toFixed(5)}, tabela diz ${linha.soma}`,
    );
  }
}

const porId = Object.fromEntries(modelos.map((m) => [m.id, m]));
const pct = (id: string) => A.tabela.find((l) => l.modelo === id)!.pct;
const soma = (id: string) => A.tabela.find((l) => l.modelo === id)!.soma;
const dupla = +(pct('haiku') + pct('gpt-4.1')).toFixed(1);
const pico = A.gastoDiario.reduce((a, b) => (b.valor > a.valor ? b : a));
const modelosNoPico = Object.keys(A.custoDiario.find((d) => d.dia === pico.dia)!.valores).length;
const unicoComTodos =
  modelosNoPico === modelos.length &&
  A.custoDiario.filter((d) => Object.keys(d.valores).length === modelos.length).length === 1;

// Parágrafo de leitura: só fatos dos dados. Montado como string porque, no template,
// o Astro descarta a quebra de linha ao lado de uma {expressão} e cola as palavras.
const m = (id: string) => porId[id].nome;
const leitura = en
  ? `From Oct 1 to Oct 31, total cost was ≈ $${A.custoTotal.toFixed(2)}. ` +
    `The most expensive model was ${m('haiku')}, at $${soma('haiku')} (${pct('haiku')}% of the total), ` +
    `followed by ${m('gpt-4.1')}, the eval's judge, at $${soma('gpt-4.1')} (${pct('gpt-4.1')}%): together, ${dupla}% of the spend. ` +
    `${m('gemini')} added up to $${soma('gemini')} (${pct('gemini')}%), ${m('gpt-4o-mini')} $${soma('gpt-4o-mini')} ` +
    `(${pct('gpt-4o-mini')}%) and ${m('deepseek')} $${soma('deepseek')} (${pct('deepseek')}%). ` +
    `The highest-spend day was ${pico.dia}, at $${pico.valor.toFixed(3)}` +
    `${unicoComTodos ? ', the only day all five models were called' : ''}.`
  : `De 01 a 31/10, o custo total foi de ≈ $${A.custoTotal.toFixed(2)}. ` +
    `O modelo mais caro foi o ${m('haiku')}, com $${soma('haiku')} (${pct('haiku')}% do total), ` +
    `seguido do ${m('gpt-4.1')}, o juiz do eval, com $${soma('gpt-4.1')} (${pct('gpt-4.1')}%): juntos, ${dupla}% do gasto. ` +
    `${m('gemini')} somou $${soma('gemini')} (${pct('gemini')}%), ${m('gpt-4o-mini')} $${soma('gpt-4o-mini')} ` +
    `(${pct('gpt-4o-mini')}%) e ${m('deepseek')} $${soma('deepseek')} (${pct('deepseek')}%). ` +
    `O dia de maior gasto foi ${pico.dia}, com $${pico.valor.toFixed(3)}` +
    `${unicoComTodos ? ', o único em que os cinco modelos foram chamados' : ''}.`;

// rótulo visível no topo das colunas de cache: % do prompt que veio do cache
const rotulosCache = B.cache.map((d) => {
  const v = d.valores as Record<string, number>;
  const total = (v.uncached ?? 0) + (v.cached ?? 0);
  return `${(((v.cached ?? 0) / total) * 100).toFixed(1)}%`;
});

const T = en
  ? {
      intro:
        "Every eval call (classifiers and judge) went through OpenRouter. The panels below reproduce the account's Activity dashboard for the project period.",
      fonte: `Source: OpenRouter — Activity dashboard (${A.periodo} for total cost; ${B.periodo} for the rest)`,
      kpis: ['Total cost · Oct 1–31', 'Total spend · Sep 30–Oct 29', 'Requests', 'Token volume', 'Cache rate', 'Average cost per 1M tokens'],
      custoModelo: 'Cost by model',
      custoDiario: 'Daily cost by model (USD)',
      caption: 'Cost by model over the period: minimum, maximum, average, sum and share of the total',
      gasto: 'Daily spend',
      gastoTotal: 'Total daily spend (USD)',
      req: 'Requests by model',
      reqTitulo: 'Requests per day and model',
      tokens: 'Tokens by type',
      tokensTitulo: 'Tokens per day and type',
      cache: 'Prompt cache',
      cacheTitulo: 'Prompt tokens per day, with and without cache',
      cacheResumo: 'Cached share per day',
      cacheObs: 'Label on top: % of prompt tokens served from cache.',
      nota: 'Daily values extracted from the dashboard charts; totals as reported by OpenRouter. Panel B covers up to Oct 29.',
    }
  : {
      intro:
        'Todas as chamadas do eval (classificadores e juiz) passaram pelo OpenRouter. Os painéis abaixo reproduzem o dashboard de Activity da conta no período do projeto.',
      fonte: `Fonte: OpenRouter — painel de Activity (${A.periodo} para o custo total; ${B.periodo} para os demais)`,
      kpis: ['Custo total · 01–31/10', 'Gasto total · 30/09–29/10', 'Requisições', 'Volume de tokens', 'Taxa de cache', 'Custo médio por 1M tokens'],
      custoModelo: 'Custo por modelo',
      custoDiario: 'Custo diário por modelo (US$)',
      caption: 'Custo por modelo no período: mínimo, máximo, média, soma e participação no total',
      gasto: 'Gasto diário',
      gastoTotal: 'Gasto diário total (US$)',
      req: 'Requisições por modelo',
      reqTitulo: 'Requisições por dia e modelo',
      tokens: 'Tokens por tipo',
      tokensTitulo: 'Tokens por dia e tipo',
      cache: 'Cache de prompt',
      cacheTitulo: 'Tokens de prompt por dia, com e sem cache',
      cacheResumo: 'Fração cacheada por dia',
      cacheObs: 'Rótulo no topo: % dos tokens de prompt servidos do cache.',
      nota: 'Valores diários extraídos dos gráficos do painel; totais conforme a OpenRouter. O Painel B cobre até 29/10.',
    };

const kpiValores = [
  `≈ $${A.custoTotal.toFixed(2)}`,
  B.kpis.gastoTotal,
  B.kpis.requisicoes,
  B.kpis.volumeTokens,
  B.kpis.taxaCache,
  B.kpis.custoMedio,
];
const kpis = kpiValores.map((valor, i) => ({ valor, label: T.kpis[i] }));
---

<div class="custos">
  <p>{T.intro}</p>

  <div class="bloco">
    <KpiRow itens={kpis} />
    <p class="fonte">{T.fonte}</p>
  </div>

  <ChartPanel titulo={T.custoModelo} periodo={A.periodo} series={modelos} largo>
    <StackedBarChart titulo={T.custoDiario} series={modelos} days={A.custoDiario} yFormat="usd" />
    <ModelBreakdown linhas={A.tabela} modelos={modelos} caption={T.caption} />
  </ChartPanel>

  <div class="grid">
    <ChartPanel titulo={T.gasto} periodo={A.periodo} series={[{ id: 'spend', nome: 'OpenRouter Spend', cor: '#EE562F' }]}>
      <AreaChart id="gasto" titulo={T.gastoTotal} nomeSerie="OpenRouter Spend" cor="#EE562F" pontos={A.gastoDiario} yFormat="usd" />
      <p class="obs">BYOK: ${A.byok}</p>
    </ChartPanel>

    <ChartPanel titulo={T.req} periodo={B.periodo} series={modelos}>
      <StackedBarChart titulo={T.reqTitulo} series={modelos} days={B.requisicoes} yFormat="int" />
    </ChartPanel>

    <ChartPanel titulo={T.tokens} periodo={B.periodo} series={B.tokensSeries}>
      <StackedBarChart titulo={T.tokensTitulo} series={B.tokensSeries} days={B.tokens} yFormat="tokens" />
    </ChartPanel>

    <ChartPanel titulo={T.cache} periodo={B.periodo} series={B.cacheSeries}>
      <StackedBarChart
        titulo={T.cacheTitulo}
        series={B.cacheSeries}
        days={B.cache}
        yFormat="tokens"
        rotulosTopo={rotulosCache}
        resumo={`${T.cacheResumo}: ${B.cache.map((d, i) => `${d.dia} ${rotulosCache[i]}`).join(', ')}.`}
      />
      <p class="obs">{T.cacheObs}</p>
    </ChartPanel>
  </div>

  <p>{leitura}</p>

  <p class="nota">{T.nota}</p>
</div>

<style>
  .custos {
    display: grid;
    gap: 1.5rem;
  }
  .custos > :global(*) {
    margin: 0;
  }
  .bloco {
    display: grid;
    gap: 0.75rem;
  }
  .grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 768px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .fonte,
  .nota,
  .obs {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.5;
    color: var(--text-muted);
  }
  .obs {
    margin: 0;
  }
</style>
