---
import type { CollectionEntry } from 'astro:content';
import { formatarData } from '../utils/format';
import { getLang, ui, projectUrl, slugOf } from '../i18n';

interface Props {
  projeto: CollectionEntry<'projetos'>;
  delay?: number;
}
const { projeto, delay = 0 } = Astro.props;
const { titulo, resumo, area, stack, data, tempoDedicado } = projeto.data;
const lang = getLang(Astro.currentLocale);
const href = projectUrl(lang, slugOf(projeto.id));
---

<article class="card" data-reveal="clip" data-reveal-delay={delay}>
  <span class="eyebrow">{area}</span>
  <h3 class="title">
    <a href={href}>{titulo}</a>
  </h3>
  <p class="summary">{resumo}</p>
  <ul class="pills" aria-label="Stack">
    {stack.map((s) => <li class="pill">{s}</li>)}
  </ul>
  <div class="foot">
    <p class="meta">
      <time datetime={data.toISOString().slice(0, 10)}>{formatarData(data, lang)}</time>
      {tempoDedicado && <span> · {tempoDedicado}</span>}
    </p>
    <span class="cta" aria-hidden="true">{ui[lang].card.cta} <span class="arrow">→</span></span>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: clamp(1.5rem, 4vw, 2rem);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    transition:
      border-color var(--dur-base) ease,
      background-color var(--dur-base) ease,
      transform var(--dur-base) var(--ease-expo);
  }
  .title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.6rem, 3.5vw, 2rem);
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .title a {
    color: var(--text-strong);
    text-decoration: none;
  }
  /* o link do título cobre o card inteiro: um único alvo clicável e um único tab stop */
  .title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-lg);
  }
  .title a:focus-visible {
    outline: none;
  }
  .title a:focus-visible::after {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .summary {
    color: var(--text);
    line-height: 1.65;
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin-top: auto;
    padding-top: 0.5rem;
  }
  .meta {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }
  .cta {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--accent);
  }
  .arrow {
    display: inline-block;
    transition: transform var(--dur-base) var(--ease-expo);
  }
  @media (hover: hover) and (pointer: fine) {
    .card:hover {
      border-color: var(--accent-40);
      background: var(--surface-2);
      transform: translateY(-2px);
    }
    .card:hover .arrow {
      transform: translateX(4px);
    }
  }
</style>
