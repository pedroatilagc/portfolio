---
import './chart.css';
import { getLang, ui } from '../../i18n';
import type { Serie } from './scale';

interface Props {
  titulo: string;
  periodo: string;
  series?: Serie[];
  largo?: boolean;
}
const { titulo, periodo, series = [], largo = false } = Astro.props;
const t = ui[getLang(Astro.currentLocale)].charts;
---

<figure class:list={['panel', { largo }]}>
  <header class="head">
    <h3 class="titulo">{titulo}</h3>
    {
      series.length > 0 && (
        <ul class="legenda" aria-label={t.legend}>
          {series.map((s) => (
            <li>
              <span class="ch-sw" style={`--sw:${s.cor}`} aria-hidden="true" />
              {s.nome}
            </li>
          ))}
        </ul>
      )
    }
  </header>
  <slot />
  <figcaption class="fonte">{t.source} ({periodo})</figcaption>
</figure>

<style>
  .panel {
    margin: 0;
    min-width: 0;
    padding: clamp(1rem, 3vw, 1.5rem);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }
  .head {
    display: grid;
    gap: 0.6rem;
  }
  .titulo {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--text-strong);
    margin: 0;
  }
  .legenda {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--text-xs);
    color: var(--text);
  }
  .legenda li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0;
  }
  .fonte {
    margin-top: auto;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.5;
    color: var(--text-muted);
  }
</style>
